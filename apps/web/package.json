  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "wrangler": "^4.28.0"
  }
}

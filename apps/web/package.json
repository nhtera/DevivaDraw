{
  "name": "@deviva-draw/web",
  "version": "0.9.0",
  "private": true,
  "description": "Deviva Draw standalone web app (draw.deviva.app) — Vite + React SPA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",

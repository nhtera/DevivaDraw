{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deviva Draw",
  "version": "0.11.4",
  "identifier": "app.deviva.draw",
  "build": {
    "beforeDevCommand": "pnpm vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 data: blob: https://collab-draw.deviva.app wss://collab-draw.deviva.app http://localhost:8788 ws://localhost:8788 ws:"
      },
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: https://collab-draw.deviva.app wss://collab-draw.deviva.app ws:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "category": "Productivity",
    "shortDescription": "Open-source infinite-canvas whiteboard",
    "fileAssociations": [
      {
        "ext": [
          "devivadraw"
        ],
        "name": "Deviva Draw Document",
        "description": "Deviva Draw whiteboard document",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCNjkwQThDRDg3NUZBNTUKUldSVituWFlqQXBwdStsdUZ2eHRsTmdJNHBxclVEOUFJb2MzMWZ0OXZ1b1BqdEZmSjQwT1hQTFIK",
      "endpoints": [
        "https://github.com/nhtera/DevivaDraw/releases/latest/download/latest.json"
      ]
    }
  }
}

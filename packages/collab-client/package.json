{
  "name": "@deviva-draw/collab-client",
  "version": "0.2.0",
  "description": "Realtime sync client for Deviva Draw: WebSocket transport, E2E crypto, presence, conflict resolution",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "whiteboard",
    "realtime",
    "websocket",
    "collaboration",
    "e2e-encryption",
    "presence"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhtera/DevivaDraw.git",
    "directory": "packages/collab-client"
  },
  "homepage": "https://github.com/nhtera/DevivaDraw#readme",
  "bugs": "https://github.com/nhtera/DevivaDraw/issues",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/add-esm-import-extensions.mjs dist",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@deviva-draw/engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

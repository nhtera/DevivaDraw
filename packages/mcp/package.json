{
  "name": "@deviva-draw/mcp",
  "version": "0.5.0",
  "description": "MCP server for Deviva Draw: lets AI agents create, edit, query, and export whiteboard scenes headlessly",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "whiteboard",
    "diagram",
    "ai-agent",
    "drawing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhtera/DevivaDraw.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/nhtera/DevivaDraw#readme",
  "bugs": "https://github.com/nhtera/DevivaDraw/issues",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts"
  },
  "bin": {
    "deviva-draw-mcp": "./dist/stdio.js"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "tsx src/stdio.ts",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/add-esm-import-extensions.mjs dist",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@deviva-draw/engine": "workspace:*",
    "@modelcontextprotocol/sdk": "~1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.6"
  }
}

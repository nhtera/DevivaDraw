{
  "name": "@deviva-draw/engine",
  "version": "0.1.0",
  "description": "Framework-agnostic whiteboard core: element model, scene store, history, renderer, geometry, tools",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "whiteboard",
    "canvas",
    "infinite-canvas",
    "drawing",
    "diagram",
    "vector-graphics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhtera/DevivaDraw.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/nhtera/DevivaDraw#readme",
  "bugs": "https://github.com/nhtera/DevivaDraw/issues",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/add-esm-import-extensions.mjs dist",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "fractional-indexing": "^4.0.0",
    "perfect-freehand": "^1.2.3",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
